-- custo do kit inicial (ferramentas + 1 pacote de cada insumo), calculado do Config
local kitTools, kitSupplies = 0, 0
for _, k in Config.ToolOrder do
	kitTools += Config.ToolPrices[k]
end
for _, k in Config.SupplyOrder do
	kitSupplies += Config.Supplies[k].price
end
local kitTotal = kitTools + kitSupplies
local S = Config.Supplies
local L = Config.GovLoan
local cancelHours = math.floor(Config.CancelAfterSeconds / Config.HourSeconds)
