do
	local news = nil
	for _, p in Wiki.Pages do
		if p.id == "novidades" then
			news = p
		end
	end
	if news then
		local body = { "Tudo o que entrou no jogo, do mais novo para o mais antigo." }
		for _, entry in Wiki.Changelog do
			table.insert(body, "")
			table.insert(body, "# " .. entry.date)
			for _, it in entry.items do
				table.insert(body, "- " .. it)
			end
		end
		news.body = body
	end
end

function Wiki.byId(id: string): any
	for _, p in Wiki.Pages do
		if p.id == id then
			return p
		end
	end
	return nil
end

return Wiki
